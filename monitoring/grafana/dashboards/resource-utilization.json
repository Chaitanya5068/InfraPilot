{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "title": "Host CPU Utilization %",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "Host CPU %" }
      ]
    },
    {
      "title": "Host Memory Utilization %",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Host Mem %" }
      ]
    },
    {
      "title": "Root Disk Utilization %",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} * 100)", "legendFormat": "Disk %" }
      ]
    },
    {
      "title": "Network I/O Rate (Bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total[5m])", "legendFormat": "Rx (Recv)" },
        { "expr": "rate(node_network_transmit_bytes_total[5m])", "legendFormat": "Tx (Sent)" }
      ]
    },
    {
      "title": "Per-Container CPU Usage (Seconds Total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum by(name)(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}" }
      ]
    },
    {
      "title": "Per-Container Memory Consumption (Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "container_memory_usage_bytes{name!=\"\"}", "legendFormat": "{{name}}" }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["infrapilot", "resources"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "2. Resource Utilization",
  "uid": "res-util"
}
