{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Application Uptime Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"app\"}", "legendFormat": "App Up" }
      ]
    },
    {
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "Rate (5m)" }
      ]
    },
    {
      "title": "HTTP Error Rate % (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m])) * 100", "legendFormat": "5xx Error %" }
      ]
    },
    {
      "title": "p95 Latency (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by(le)(rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95 Latency" }
      ]
    },
    {
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "Heap Used" }
      ]
    },
    {
      "title": "Active HikariCP DB Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "Active Connections" }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["infrapilot", "application"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "1. Application Health",
  "uid": "app-health"
}
