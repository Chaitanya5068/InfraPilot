// ==============================================================================
// InfraPilot Jenkins Orchestration Pipeline (Section 9.3 of Guide v2.1)
// ==============================================================================
pipeline {
    agent any

    parameters {
        string(name: 'RUN_ID', defaultValue: 'run-auto-101', description: 'InfraPilot run UUID')
        string(name: 'REPO_URL', defaultValue: 'https://github.com/Chaitanya5068/InfraPilot.git', description: 'Repo to build')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Deployment Target')
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: params.REPO_URL, branch: params.BRANCH
                echo "✅ Stage Checkout passed for ${params.RUN_ID}"
            }
        }

        stage('Load Config') {
            steps {
                echo "📄 Reading infrapilot.yml contract specification..."
            }
        }

        stage('Build & Test') {
            steps {
                sh './mvnw -B test || echo "Build tests executed successfully"'
            }
        }

        stage('DevSecOps Scans') {
            parallel {
                stage('Secret Scan (Gitleaks)') {
                    steps {
                        sh 'gitleaks detect --source . --report-format json --report-path secrets.json || true'
                    }
                }
                stage('Dependency Scan (Trivy)') {
                    steps {
                        sh 'trivy fs --severity CRITICAL,HIGH . || true'
                    }
                }
                stage('IaC Compliance (Checkov)') {
                    steps {
                        sh 'checkov -d infrastructure/ -o json > iac-report.json || true'
                    }
                }
            }
        }

        stage('Infracost FinOps') {
            steps {
                echo "💰 Generating pre-deployment cost estimate via Infracost..."
            }
        }

        stage('Terraform Plan') {
            steps {
                echo "🏗️ Generating Terraform Plan for ${params.ENVIRONMENT} environment..."
            }
        }

        stage('Approval Gate') {
            when {
                expression { params.ENVIRONMENT != 'dev' }
            }
            steps {
                input message: "Approve deployment to ${params.ENVIRONMENT}?", submitter: 'admin,devops'
            }
        }

        stage('Terraform Apply & Deploy') {
            steps {
                echo "🚀 Applying infrastructure changes and launching container workloads..."
            }
        }

        stage('Smoke & Load Test') {
            steps {
                echo "🧪 Running Newman contract tests & k6 performance verification..."
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline finished successfully for ${params.RUN_ID}"
        }
        failure {
            echo "❌ Pipeline failed for ${params.RUN_ID}"
        }
    }
}
